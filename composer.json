{
  "name": "xefi/faker-php-locales-it-ch",
  "type": "library",
  "description": "Faker extension to include it_CH locale",
  "keywords": [
    "faker",
    "data",
    "locale",
    "it_CH"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Martin Soenen"
    }
  ],
  "require": {
    "php": "^8.3",
    "psr/container": "^2.0",
    "xefi/faker-php": "^1.5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload": {
    "psr-4": {
      "Xefi\\Faker\\ItCh\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Xefi\\Faker\\ItCh\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "faker": {
      "providers": [
        "Xefi\\Faker\\ItCh\\FakerItChServiceProvider"
      ]
    }
  }
}
